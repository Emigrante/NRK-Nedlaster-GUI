<Window x:Class="NRKLastNed.Views.DownloadOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nedlastings- og bearbeidingslogg"
        Height="560" Width="880"
        MinHeight="360" MinWidth="540"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextColor}"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.ico"
        Closing="Window_Closing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header med aktiv fil og fremdrift -->
            <RowDefinition Height="Auto"/>
            <!-- Terminal-output -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- HEADER: Aktiv fil, status og fremdrift              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgLight}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="lblCurrentItemHeader" Text="AKTIV FIL SOM BEARBEIDES:" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtCurrentItem"
                               Text="Ingen aktiv nedlasting"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource TextColor}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtCurrentStatus"
                               Text="Klar"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="12"
                               Margin="0,4,0,8"/>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="1" Content="Tøm logg" x:Name="btnClear"
                        Click="BtnClear_Click"
                        Style="{StaticResource MenuButtonStyle}"
                        Padding="12,6"
                        VerticalAlignment="Top"
                        ToolTip="Tømmer terminal-loggen"/>

                <!-- Fremdriftslinjer for aktiv fil: 1. Nedlasting, 2. Rekoding og klargjøring -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Nedlasting -->
                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Nedlasting fra NRK:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtDownloadPercent" Grid.Column="1"
                                   Text="0%" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="pbDownloadProgress" Grid.Row="1"
                                 Height="8"
                                 Background="{DynamicResource BorderColor}"
                                 Foreground="{DynamicResource AccentColor}"
                                 BorderThickness="0"
                                 Maximum="100" Value="0"
                                 Margin="0,0,0,8"/>

                    <!-- 2. Rekoding og klargjøring -->
                    <Grid Grid.Row="2" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtProcessingLabel" Text="Rekoding og klargjøring:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtProcessingPercent" Grid.Column="1"
                                   Text="Venter..." FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="pbProcessingProgress" Grid.Row="3"
                                 Height="8"
                                 Background="{DynamicResource BorderColor}"
                                 Foreground="#2ECC71"
                                 BorderThickness="0"
                                 Maximum="100" Value="0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- TERMINAL-OUTPUT                                     -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0C0D0E" CornerRadius="6"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <TextBox x:Name="txtOutput"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="11.5"
                     Background="Transparent"
                     Foreground="#70E080"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="8"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FOOTER                                              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="chkAutoOpen"
                          Content="Åpne automatisk ved nedlasting"
                          Click="ChkAutoOpen_Click"
                          Foreground="{DynamicResource TextMuted}"
                          FontSize="11.5"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          ToolTip="Vis dette vinduet automatisk hver gang en nedlasting eller bearbeiding starter"/>
                <CheckBox x:Name="chkAutoClose"
                          Content="Lukk automatisk når alt er ferdig"
                          Click="ChkAutoClose_Click"
                          Foreground="{DynamicResource TextMuted}"
                          FontSize="11.5"
                          VerticalAlignment="Center"
                          ToolTip="Skjul dette vinduet automatisk når alle nedlastinger i køen er fullført"/>
                <CheckBox x:Name="chkDebugLog"
                          Content="Detaljert logg (debug)"
                          Click="ChkDebugLog_Click"
                          Foreground="{DynamicResource TextMuted}"
                          FontSize="11.5"
                          Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          ToolTip="Vis detaljert teknisk framdrift og prosessdata i stedet for ren oppsummering"/>
            </StackPanel>

            <!-- Total fremdrift (vises kun når det er flere filer i køen) -->
            <StackPanel x:Name="pnlTotalProgress" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="Collapsed">
                <TextBlock Text="Total fremdrift:" Foreground="{DynamicResource TextMuted}"
                           FontSize="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="txtTotalPercent" Text="0%" FontWeight="SemiBold"
                           FontSize="11.5" Foreground="{DynamicResource AccentColor}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Skjul vindu"
                    Click="BtnHide_Click"
                    Style="{StaticResource MenuButtonStyle}"
                    Padding="16,6"
                    ToolTip="Skjul vinduet (nedlastingen fortsetter uforstyrret)"/>
        </Grid>
    </Grid>
</Window>
